# Written for you by `npx convex dev` into .env.local — you normally don't edit these by hand.
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud

# Set on the Convex deployment (not here), via `npx @convex-dev/auth` and `npx convex env set`:
#   JWT_PRIVATE_KEY, JWKS, SITE_URL   (auth)
#   ALLOWED_EMAILS=you@example.com    (optional: lock sign-up to your email)
#
# Set in Vercel → Project → Settings → Environment Variables:
#   CONVEX_DEPLOY_KEY   (Convex dashboard → Production → Settings → Deploy keys)
